@echo off
setlocal enabledelayedexpansion

cls
echo.
echo ??????????????????????????????????????????????????????????????
echo ?        NUUB Quick USB Installer v2.5                      ?
echo ?        Con Barra de Progreso                              ?
echo ??????????????????????????????????????????????????????????????
echo.

set "INSTALL_DIR=%APPDATA%\NUUB"
set "BIN_SOURCE=%~dp0bin"
set "LIB_SOURCE=%~dp0lib"

echo ?? Origen (USB):  %~dp0
echo ?? Destino:       %INSTALL_DIR%
echo.

REM Crear directorios
if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%"
if not exist "%INSTALL_DIR%\bin" mkdir "%INSTALL_DIR%\bin"
if not exist "%INSTALL_DIR%\lib" mkdir "%INSTALL_DIR%\lib"

REM ????????????????????????????????????????????????????????????????
REM PASO 1: Copiar Ejecutables
REM ????????????????????????????????????????????????????????????????

echo [1/4] Copiando Ejecutables...
echo ?????????????????????????????????????????????????????????????
xcopy /Y "%BIN_SOURCE%\*.exe" "%INSTALL_DIR%\bin\" >nul
if errorlevel 1 (
    echo ? Error: No se pudieron copiar ejecutables
    pause
    exit /b 1
)
echo  [????????????????????????????????????????] 100%%
echo  ? Ejecutable instalado
echo.

REM ????????????????????????????????????????????????????????????????
REM PASO 2: Copiar Launchers y Scripts
REM ????????????????????????????????????????????????????????????????

echo [2/4] Copiando Launchers y Scripts...
echo ?????????????????????????????????????????????????????????????
xcopy /Y "%BIN_SOURCE%\*.bat" "%INSTALL_DIR%\bin\" >nul 2>&1
xcopy /Y "%BIN_SOURCE%\*.cmd" "%INSTALL_DIR%\bin\" >nul 2>&1
xcopy /Y "%BIN_SOURCE%\*.ps1" "%INSTALL_DIR%\bin\" >nul 2>&1
echo  [????????????????????????????????????????] 100%%
echo  ? Scripts copiados
echo.

REM ????????????????????????????????????????????????????????????????
REM PASO 3: Copiar DLLs
REM ????????????????????????????????????????????????????????????????

echo [3/4] Copiando Librer?as (DLLs)...
echo ?????????????????????????????????????????????????????????????
if exist "%LIB_SOURCE%\" (
    xcopy /Y "%LIB_SOURCE%\*.dll" "%INSTALL_DIR%\lib\" >nul
    echo  [????????????????????????????????????????] 100%%
    echo  ? Librer?as copiadas
) else (
    echo  ??  Carpeta lib no encontrada
)
echo.

REM ????????????????????????????????????????????????????????????????
REM PASO 4: Crear Acceso Directo
REM ????????????????????????????????????????????????????????????????

echo [4/4] Creando Acceso Directo...
echo ?????????????????????????????????????????????????????????????
echo  [????????????????????????????????????????] 100%%

REM Crear acceso directo usando VBScript
(
    echo Set oWS = WScript.CreateObject("WScript.Shell"^)
    echo sLinkFile = oWS.SpecialFolders("StartMenu"^) ^& "\NUUB.lnk"
    echo Set oLink = oWS.CreateShortcut(sLinkFile^)
    echo oLink.TargetPath = "%INSTALL_DIR%\bin\launcher.bat"
    echo oLink.WorkingDirectory = "%INSTALL_DIR%\bin"
    echo oLink.Save
) > "%temp%\create_shortcut.vbs"
cscript.exe /nologo "%temp%\create_shortcut.vbs"
del "%temp%\create_shortcut.vbs"

echo  ? Acceso directo creado
echo.

REM ????????????????????????????????????????????????????????????????
REM RESUMEN FINAL
REM ????????????????????????????????????????????????????????????????

echo ??????????????????????????????????????????????????????????????
echo ?  ? INSTALACION COMPLETADA EXITOSAMENTE!                 ?
echo ??????????????????????????????????????????????????????????????
echo.
echo ?? Ubicaci?n de Instalaci?n:
echo    %INSTALL_DIR%
echo.
echo ?? Como Ejecutar NUUB:
echo    1. Presiona tecla Windows
echo    2. Escribe: NUUB
echo    3. Presiona Enter
echo.
echo    O ejecuta: %INSTALL_DIR%\bin\launcher.bat
echo.
echo ????????????????????????????????????????????????????????????????
echo.
pause
